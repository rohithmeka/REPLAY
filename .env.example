# Copy the lines you need into your terminal (or your host's environment settings).

# Which model the agents use: mock (default, offline) | gemini | groq | ollama
RELAY_PROVIDER=mock

# Gemini (free key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq (free key from console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local, no key, no internet)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300

# Photo checks: auto | gemini | groq | ollama | none
# "auto" uses Gemini for vision whenever GEMINI_API_KEY is set (even if agents run on another provider).
RELAY_VISION_PROVIDER=auto
GEMINI_VISION_MODEL=gemini-3.8-flash
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Governance limits
RELAY_MAX_TOOL_ITERATIONS=6
RELAY_MAX_AUTONOMOUS_COST=1500
RELAY_MAX_CYCLES=3
# Seconds to wait for the resident before closing as "verified, unconfirmed".
# 86400 = 24 h in production; use 60 for a demo.
RELAY_RESIDENT_WINDOW=86400

# Pause between mock agent steps so the live trace is watchable (seconds)
RELAY_MOCK_DELAY=0.45
